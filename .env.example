# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/blogify?schema=public"

# NextAuth configuration
NEXTAUTH_SECRET="blogify-super-secret-development-jwt-key-2026"
NEXTAUTH_URL="http://localhost:3000"

# Social OAuth Provider Credentials (Issue #25 & Issue #28)
# When configured, users can log in directly using their Google, GitHub, or LinkedIn accounts.
# If left empty/placeholder in development, the system seamlessly uses the local sandbox social mode.
#
# 1. Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
#    Authorized redirect URI: http://localhost:3000/api/auth/callback/google (or your production domain)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 2. GitHub OAuth (GitHub -> Settings -> Developer Settings -> OAuth Apps)
#    Authorization callback URL: http://localhost:3000/api/auth/callback/github (or your production domain)
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# 3. LinkedIn OAuth (LinkedIn Developer Portal -> Auth)
#    Authorized redirect URL: http://localhost:3000/api/auth/callback/linkedin (or your production domain)
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
